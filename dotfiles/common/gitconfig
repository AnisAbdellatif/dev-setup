# Included from ~/.gitconfig: [include] path = ~/dev/dev-setup/dotfiles/common/gitconfig
# No identity or credentials here; user.name/user.email live in ~/.gitconfig itself.
[init]
	defaultBranch = main
[core]
	longpaths = true
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
