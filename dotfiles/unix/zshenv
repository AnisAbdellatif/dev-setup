# ~/.zshenv: read by every zsh, including non-interactive (ssh commands, agent hooks). PATH only.
# Machine-specific lines go in ~/.zshrc.local (interactive) or are added here by hand and not committed.

typeset -U path PATH

[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
[[ -x /usr/local/bin/brew && ! -x /opt/homebrew/bin/brew ]] && eval "$(/usr/local/bin/brew shellenv)"
[[ -x /home/linuxbrew/.linuxbrew/bin/brew ]] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

[[ -r $HOME/.cargo/env ]] && . "$HOME/.cargo/env"

export BUN_INSTALL="$HOME/.bun"
path=($HOME/.local/bin $BUN_INSTALL/bin $path)
