# ~/.zshrc: interactive shells. PATH lives in ~/.zshenv. Machine specifics in ~/.zshrc.local.

typeset -U path PATH

# Optional: oh-my-zsh (+ powerlevel10k) if the user installed it; otherwise starship below.
if [[ -d $HOME/.oh-my-zsh ]]; then
  export ZSH="$HOME/.oh-my-zsh"
  [[ -d $ZSH/custom/themes/powerlevel10k ]] && ZSH_THEME="powerlevel10k/powerlevel10k"
  plugins=(git sudo colored-man-pages history-substring-search)
  source $ZSH/oh-my-zsh.sh
  [[ -f $HOME/.p10k.zsh ]] && source $HOME/.p10k.zsh
fi

# Autosuggestions / syntax highlighting from brew, apt or pacman, wherever they live.
for f in \
  "${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
  /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  "${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" \
  /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh; do
  [[ -r $f ]] && source "$f"
done

command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
[[ -z $ZSH_THEME ]] && command -v starship >/dev/null && eval "$(starship init zsh)"
command -v fastfetch >/dev/null && fastfetch

# Machine-local (JAVA_HOME, SSH_AUTH_SOCK, Android/Flutter, proxies); never committed.
[[ -r $HOME/.zshrc.local ]] && source "$HOME/.zshrc.local"
